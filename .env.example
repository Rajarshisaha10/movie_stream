# Server Configuration
PORT=3000
HOST=0.0.0.0

# Security / Authentication
# Change this to a family password your mom can easily type (or keep it simple for her)
STREAM_PASSWORD=family123
SESSION_SECRET=super-secret-family-streaming-key-change-me-in-production

# Library & Cache Paths
# You can set this to an absolute path like D:/Movies or /home/user/Movies
MOVIES_DIR=./movies
CACHE_DIR=./cache

# Transcoding Performance
# Number of CPU threads ffmpeg should use (0 = auto)
FFMPEG_THREADS=0

# HLS Segment Duration in seconds
HLS_SEGMENT_DURATION=4
