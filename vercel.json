{
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/backend-url",
      "destination": "/api/backend-url"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/proxy?path=/api/$1"
    },
    {
      "source": "/stream/(.*)",
      "destination": "/api/proxy?path=/stream/$1"
    }
  ]
}
